<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <h1 class="text-4xl font-bold text-slate-900">Second Brain</h1>
      <p class="text-slate-600 mt-2">Your temporal knowledge system</p>
    </div>
  </header>

  <!-- Main content -->
  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- Quick ask box -->
    <div class="mb-12">
      <div class="bg-white rounded-xl shadow-md border border-slate-200 p-8">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Ask your second brain</h2>
        <div class="flex gap-3">
          <input
            type="text"
            placeholder="What is RAG? How do embeddings work?"
            class="flex-1 px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            routerLink="/query"
            class="px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors"
          >
            Ask
          </button>
        </div>
      </div>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="bg-white rounded-xl shadow-md border border-slate-200 p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-slate-600 text-sm font-medium">Total Chunks</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">{{ stats?.totalChunks || 0 }}</p>
          </div>
          <div class="text-4xl text-blue-200">📚</div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-slate-200 p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-slate-600 text-sm font-medium">Sources</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">{{ stats?.totalSources || 0 }}</p>
          </div>
          <div class="text-4xl text-amber-200">📄</div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-slate-200 p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-slate-600 text-sm font-medium">Queries</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">{{ stats?.totalQueries || 0 }}</p>
          </div>
          <div class="text-4xl text-emerald-200">💬</div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md border border-slate-200 p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-slate-600 text-sm font-medium">Avg Access/Chunk</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">{{ (stats?.accessStats?.avgAccessPerChunk || 0) | number:'1.1-1' }}</p>
          </div>
          <div class="text-4xl text-purple-200">⚡</div>
        </div>
      </div>
    </div>

    <!-- Most used chunks -->
    <div class="bg-white rounded-xl shadow-md border border-slate-200 p-8 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Most Used Knowledge</h2>
      <div class="space-y-4">
        <div *ngFor="let chunk of stats?.accessStats?.mostUsedChunks; let i = index" class="flex items-center gap-4 p-4 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
          <div class="text-2xl font-bold text-blue-600 w-8">{{ i + 1 }}</div>
          <div class="flex-1">
            <p class="font-medium text-slate-900">{{ chunk.source }}</p>
            <p class="text-sm text-slate-600">{{ chunk.accessCount }} accesses</p>
          </div>
          <div class="text-right">
            <div class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
              {{ chunk.accessCount }} uses
            </div>
          </div>
        </div>
        <div *ngIf="!stats?.accessStats?.mostUsedChunks?.length" class="text-center py-8 text-slate-500">
          No queries yet. Start by asking a question!
        </div>
      </div>
    </div>

    <!-- Quick actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
        routerLink="/ingest"
        class="group bg-white rounded-xl shadow-md border border-slate-200 p-8 hover:shadow-lg hover:border-blue-300 transition-all cursor-pointer"
      >
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">📥</div>
        <h3 class="text-lg font-semibold text-slate-900 mb-2">Add Knowledge</h3>
        <p class="text-slate-600 text-sm">Ingest notes, PDFs, and articles</p>
      </a>

      
        routerLink="/sources"
        class="group bg-white rounded-xl shadow-md border border-slate-200 p-8 hover:shadow-lg hover:border-amber-300 transition-all cursor-pointer"
      >
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">📚</div>
        <h3 class="text-lg font-semibold text-slate-900 mb-2">Manage Sources</h3>
        <p class="text-slate-600 text-sm">View, organize, and delete sources</p>
      </a>

      
        routerLink="/insights"
        class="group bg-white rounded-xl shadow-md border border-slate-200 p-8 hover:shadow-lg hover:border-emerald-300 transition-all cursor-pointer"
      >
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">📊</div>
        <h3 class="text-lg font-semibold text-slate-900 mb-2">Insights</h3>
        <p class="text-slate-600 text-sm">Growth, decay, and contradictions</p>
      </a>
    </div>
  </main>
</div>